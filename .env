# Core
OPENAI_API_KEY=sk...
NOOR_MODEL=mistral:latest
NOOR_NUM_CTX=4096
COMPLIANCE_MODE=true

# --- Local Ollama on Runpod ---
# Base is the "root" (no /api suffix), API_URL is the chat endpoint
OLLAMA_BASE=http://localhost:11434
OLLAMA_API_URL=http://localhost:11434/api/chat

# --- HTTP ---
# Local run defaults
NOOR_HTTP_TIMEOUT=30
NOOR_KEEP_ALIVE=5m        


# Generation
NOOR_TEMP_ANALYZE=0.0
NOOR_TEMP_REFACTOR=0.0
NOOR_ANALYZE_NUM_PREDICT=512
NOOR_REFACTOR_NUM_PREDICT=1024

# Chunking
NOOR_MAX_CHUNK_LINES=120
NOOR_CHUNK_OVERLAP=20

# IO / CLI
NOOR_REPORTS_DIR=reports
NOOR_MAX_FILE_BYTES=100000
NOOR_ALLOWED_EXT=.py,.js,.ts,.java