# Default backend and model
NOOR_MODE=ollama
NOOR_MODEL=mistral:latest
NOOR_NUM_CTX=4096

# Output and file collection
NOOR_REPORTS_DIR=reports
NOOR_MAX_FILE_BYTES=400000
NOOR_ALLOWED_EXT=.py,.cs

# Ollama connection
OLLAMA_BASE=http://localhost:11434
OLLAMA_API_URL=http://localhost:11434/api/chat
NOOR_HTTP_TIMEOUT=60
NOOR_KEEP_ALIVE=5m

# Generation settings
NOOR_TEMP_ANALYZE=0.0
NOOR_TEMP_REFACTOR=0.0
NOOR_ANALYZE_NUM_PREDICT=512
NOOR_REFACTOR_NUM_PREDICT=1024
NOOR_MAX_CHUNK_LINES=120
NOOR_CHUNK_OVERLAP=20

# Set to false to enable detailed logging.
COMPLIANCE_MODE=true

# OpenAI only: install with `python -m pip install ".[openai]"`.
# OPENAI_API_KEY=sk-...

# Optional license-service settings.
# NOOR_LICENSE_SERVER=https://noor-license.onrender.com
# NOOR_LICENSE_TIMEOUT=15
# NOOR_LICENSE_KEY=